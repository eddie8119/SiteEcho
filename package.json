{
  "name": "site-shot",
  "private": true,
  "version": "1.0.9",
  "type": "module",
  "moduleAliases": {
    "@": [
      "src"
    ],
    "@frontend": [
      "src"
    ]
  },
  "scripts": {
    "dev": "vite --host",
    "build": "vue-tsc -b && vite build && node scripts/generate-seo-pages.js",
    "lint": "npm run lint:check && npm run lint:style:check",
    "lint:check": "npm run lint:fix -- --no-fix",
    "lint:fix": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix --ignore-path .gitignore",
    "lint:style": "stylelint **/*.{vue,scss} --fix",
    "lint:style:check": "stylelint **/*.{vue,scss}",
    "format": "prettier --write \"src/**/*.{js,jsx,ts,tsx,vue,scss,css,md,json}\"",
    "format:check": "prettier --check \"src/**/*.{js,jsx,ts,tsx,vue,scss,css,md,json}\"",
    "fix": "npm run format && npm run lint:fix && npm run lint:style",
    "test": "vitest",
    "test:watch": "vitest watch",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "preview": "vite preview",
    "locales:build": "node scripts/build-locales.js",
    "pwa:assets": "node scripts/generate-pwa-icons.js",
    "cap:sync": "npx cap sync",
    "cap:android": "npx cap open android",
    "cap:ios": "npx cap open ios",
    "cap:build:android": "npm run build && npx cap sync android",
    "cap:build:ios": "npm run build && npx cap sync ios",
    "android:build:release": "npm run cap:build:android && cd android && gradlew.bat bundleRelease"
  },
  "dependencies": {
    "@capacitor-community/camera-preview": "^8.0.1",
    "@capacitor/android": "^8.5.0",
    "@capacitor/app": "^8.1.1",
    "@capacitor/browser": "^8.0.3",
    "@capacitor/camera": "^8.2.0",
    "@capacitor/device": "^8.0.2",
    "@capacitor/ios": "^8.5.0",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.0",
    "@capacitor/status-bar": "^8.0.0",
    "@element-plus/icons-vue": "^2.3.1",
    "@headlessui/vue": "^1.7.23",
    "@heroicons/vue": "^2.1.3",
    "@supabase/supabase-js": "^2.49.4",
    "@tanstack/vue-query": "^5.101.4",
    "@vee-validate/zod": "^4.15.1",
    "@vueuse/core": "^11.3.0",
    "axios": "^1.7.9",
    "date-fns": "^4.4.0",
    "element-plus": "^2.14.4",
    "exceljs": "^4.4.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^2.5.2",
    "jwt-decode": "^4.0.0",
    "line-notify-nodejs": "^1.0.1",
    "node-cron": "^4.2.1",
    "pdfjs-dist": "^5.4.449",
    "pinia": "^3.0.1",
    "pinia-plugin-persistedstate": "^4.1.3",
    "primevue": "^4.3.3",
    "sharp": "^0.35.3",
    "uuid": "^13.0.0",
    "vee-validate": "^4.15.1",
    "vue": "^3.5.13",
    "vue-i18n": "^9.14.0",
    "vue-router": "^4.5.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@babel/preset-env": "^7.27.2",
    "@babel/preset-typescript": "^7.27.1",
    "@capacitor/cli": "^8.5.0",
    "@intlify/unplugin-vue-i18n": "^1.0.11",
    "@mdi/font": "^7.4.47",
    "@mdi/js": "^7.4.47",
    "@pinia/testing": "^1.0.3",
    "@rushstack/eslint-patch": "^1.12.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/vue": "^8.1.0",
    "@types/html2canvas": "^0.5.35",
    "@types/node": "^22.13.5",
    "@types/pdfjs-dist": "^2.10.377",
    "@types/uuid": "^10.0.0",
    "@types/vue": "^1.0.31",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "@vite-pwa/assets-generator": "^1.0.2",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vitest/ui": "^3.2.4",
    "@vue/compiler-sfc": "^3.5.18",
    "@vue/eslint-config-typescript": "^12.0.0",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.7.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-prettier": "^5.5.3",
    "eslint-plugin-vue": "^9.32.0",
    "identity-obj-proxy": "^3.0.0",
    "jsdom": "^26.1.0",
    "postcss": "^8.5.6",
    "postcss-html": "^1.8.0",
    "postcss-scss": "^4.0.9",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "sass-embedded": "^1.86.0",
    "stylelint": "^16.25.0",
    "stylelint-config-standard-scss": "^15.0.1",
    "stylelint-config-tailwindcss": "^1.0.0",
    "stylelint-order": "^7.0.0",
    "stylelint-scss": "^6.12.1",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.5.0",
    "vconsole": "^3.15.1",
    "vite": "^6.1.0",
    "vite-plugin-pwa": "^1.2.0",
    "vitest": "^3.2.4",
    "vue-tsc": "^2.2.0"
  }
}
